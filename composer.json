{
  "name": "seagm-swoft/validator",
  "type": "library",
  "version": "v2.1.0",
  "keywords": [
    "php",
    "swoole",
    "swoft"
  ],
  "description": "Validator component for swoft",
  "homepage": "https://github.com/swoft-cloud/swoft-validator",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.2",
    "seagm-swoft/framework": "~2.1.0"
  },
  "autoload": {
    "psr-4": {
      "Swoft\\Validator\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^8.0"
  },
  "autoload-dev": {
    "psr-4": {
      "SwoftTest\\Validator\\Unit\\": "test/unit",
      "SwoftTest\\Validator\\Testing\\": "test/testing"
    }
  },
  "scripts": {
    "test": "php run.php -c phpunit.xml"
  }
}
